{
  "name": "@jiwuyou/wuxianpi",
  "version": "0.1.0",
  "description": "Mobile-first personal assistant web UI powered by Pi",
  "license": "MIT",
  "bin": {
    "wuxianpi": "bin/wuxianpi.js",
    "pi-web": "bin/wuxianpi.js"
  },
  "files": [
    "bin",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/**/*.js.map",
    "public",
    "workers",
    "next.config.mjs",
    "package.json"
  ],
  "scripts": {
    "dev": "next dev -p 30141",
    "build": "next build --webpack",
    "start": "next start -p 30141",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:test": "npm --prefix apps/web run test",
    "runtime:build": "npm --prefix runtime/wuxianpi-node run build",
    "runtime:typecheck": "npm --prefix runtime/wuxianpi-node run typecheck",
    "runtime:test": "npm --prefix runtime/wuxianpi-node run test",
    "contracts:check": "python3 -m json.tool packages/contracts/runtime-manifest.v1.json >/dev/null && python3 -m json.tool packages/contracts/release-manifest.schema.json >/dev/null && bash packaging/termux/build-release.sh --help >/dev/null",
    "product:check": "npm run web:typecheck && npm run web:test && npm run runtime:typecheck && npm run contracts:check",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.2",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@lobehub/icons": "^5.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-virtual": "^3.14.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "next": "16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
