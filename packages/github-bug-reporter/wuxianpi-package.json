{
  "schemaVersion": 1,
  "id": "io.github.jiwuyou.github-bug-reporter",
  "name": "GitHub Bug 报告助手",
  "version": "1.1.0",
  "summary": "帮助 AI 整理软件问题，优先提交 GitHub，并在 GitHub 不可用时降级到 WuxianPi Hub。",
  "description": "提供统一的中文问题报告 Skill 和四个通用 Issue 工具。模型在对话中取得用户同意并声明 userConfirmed=true 后，工具优先使用本地 gh；按用户授权可降级创建 WuxianPi Hub Issue。",
  "license": "MIT",
  "categories": ["capability", "skill", "solution"],
  "requires": {
    "hostCapabilities": [
      { "id": "wuxianpi.package", "contractVersion": 1 },
      { "id": "pi.extension", "contractVersion": 1 },
      { "id": "pi.skill", "contractVersion": 1 }
    ],
    "packages": []
  },
  "build": {
    "mode": "none",
    "commands": {
      "test": {
        "command": "node --test test/*.test.mjs",
        "timeoutSeconds": 30
      }
    }
  },
  "artifacts": [],
  "contributions": [
    {
      "id": "io.github.jiwuyou.github-bug-reporter/extension.issue-submitter",
      "type": "pi.extension",
      "name": "软件问题报告工具",
      "description": "注册问题准备、提交、查看和评论工具；GitHub 优先，WuxianPi Hub 降级。",
      "path": "extension/index.js",
      "assistantSelectable": true
    },
    {
      "id": "io.github.jiwuyou.github-bug-reporter/skill.bug-reporting",
      "type": "pi.skill",
      "name": "软件问题报告流程",
      "description": "指导 AI 完成问题诊断、最小复现、双渠道查重和用户同意后的提交。",
      "path": "skills/github-bug-reporting",
      "assistantSelectable": true
    }
  ]
}
